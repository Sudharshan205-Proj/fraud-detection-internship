# ============================================================
# Python
# ============================================================

__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python distribution/build files
build/
dist/
*.egg-info/


# ============================================================
# Jupyter
# ============================================================

.ipynb_checkpoints/
*.nbconvert.ipynb
.jupyter-runtime/


# ============================================================
# Data
# ============================================================

# Raw and processed PaySim datasets are intentionally NOT
# committed because they are hundreds of MB to multiple GB.
data/raw/*
data/processed/*

# Keep directory structure in Git
!data/raw/.gitkeep
!data/processed/.gitkeep


# ============================================================
# Large Data / Archive Files
# ============================================================

# Prevent accidentally committing large alternative data formats
*.parquet
*.feather
*.arrow

# Archives
*.zip
*.tar
*.tar.gz
*.7z


# ============================================================
# Machine Learning
# ============================================================

# Generic model formats that should not be committed
*.pkl
*.pickle
*.h5
*.keras
*.onnx

# IMPORTANT:
# Do NOT ignore *.joblib globally.
#
# models/random_forest_model.joblib is required by the
# deployed Streamlit application and must remain visible
# to Git if it is within an acceptable repository/deployment size.


# ============================================================
# Environment / Secrets
# ============================================================

.env
.env.*
!.env.example

# API keys / credentials
*.pem
*.key
secrets.json


# ============================================================
# Operating System
# ============================================================

.DS_Store
Thumbs.db


# ============================================================
# IDE
# ============================================================

.vscode/

# JetBrains IDEs
.idea/
*.iml


# ============================================================
# R
# ============================================================

.Rhistory
.RData
.Ruserdata


# ============================================================
# Logs
# ============================================================

*.log


# ============================================================
# Temporary Files
# ============================================================

*.tmp
*.temp

# Excel temporary files
~$*.xlsx
~$*.xls

# R Markdown generated files
*_files/

# Backup / editor files
*.bak
*.swp
*.swo


# ============================================================
# Generated Project Outputs
# ============================================================

outputs/
reports/generated/


# ============================================================
# Generated Machine-Learning CSV Artifacts
# ============================================================

# These can become large and are reproducible from the pipeline.
results/machine-learning/*.csv
docs/machine-learning/explainability/*.csv
results/model_comparison/*.csv


# ============================================================
# Large Explainability Artifact
# ============================================================

# This is currently ~2.18 GB and MUST NOT enter Git.
docs/machine-learning/explainability/fraud-investigation-report.csv


# ============================================================
# Phase 11 - Visualization Data
# ============================================================

# Visualization datasets are intentional project deliverables.
# These are currently small curated CSVs.

!data/visualization/
!data/visualization/*.csv


# ============================================================
# Phase 11 - Visualization Figures
# ============================================================

!reports/
!reports/figures/
!reports/figures/*.png


# ============================================================
# Tableau
# ============================================================

# Keep actual Tableau workbook (.twb) visible/tracked.

# Tableau lock files
*.twb.lock

# Tableau temporary/backup files
tableau/*.twb~


# ============================================================
# SQLite Databases
# ============================================================

data/*.db
data/*.sqlite
data/*.sqlite3